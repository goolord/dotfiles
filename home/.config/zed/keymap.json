// Zed keymap
//
// For information on binding keys, see the Zed
// documentation: https://zed.dev/docs/key-bindings
//
// To see the default key bindings run `zed: open default keymap`
// from the command palette.
[
  // ---------------------------------------------------------------------------
  // Non-editor screens (welcome/splash, git diff, project search, etc.)
  // ---------------------------------------------------------------------------
  {
    "context": "EmptyPane || SharedScreen || ProjectDiff || ProjectSearchView",
    "unbind": {
      "space f": "file_finder::Toggle"
    },
    "bindings": {
      "space f f": "file_finder::Toggle",
      "space f g": "workspace::NewSearch"
    }
  },
  // ---------------------------------------------------------------------------
  // Workspace & Navigation
  // ---------------------------------------------------------------------------
  {
    "context": "Workspace",
    "bindings": {
      // "shift shift": "file_finder::Toggle",
      "ctrl-h": "workspace::ActivatePaneLeft",
      "ctrl-j": "workspace::ActivatePaneDown",
      "ctrl-k": "workspace::ActivatePaneUp",
      "ctrl-l": "workspace::ActivatePaneRight"
    }
  },

  {
    "context": "Editor",
    "unbind": {
      "ctrl-l": "editor::SelectLine",
      "ctrl-h": "search::ToggleReplace"
    }
  },
  // ---------------------------------------------------------------------------
  // Editor (Vim Normal / Non-Insert Mode)
  // ---------------------------------------------------------------------------
  {
    "context": "Editor && mode == full && vim_mode == normal && vim_operator == none && !BufferSearchBar",
    "bindings": {
      "space d": "project_panel::ToggleFocus",
      "space t": "terminal_panel::Toggle",
      "space f f": "file_finder::Toggle",
      "space f g": "workspace::NewSearch"
    }
  },

  // ---------------------------------------------------------------------------
  // Terminal Panel
  // ---------------------------------------------------------------------------
  {
    "context": "Terminal",
    "bindings": {
      "escape": "terminal_panel::Toggle"
    }
  },

  // ---------------------------------------------------------------------------
  // Project Panel
  // ---------------------------------------------------------------------------
  {
    "context": "ProjectPanel && not_editing && !BufferSearchBar",
    "bindings": {
      "space d": "workspace::ToggleLeftDock",
      "l": "project_panel::Open",
      "q": "project_panel::Toggle"
    }
  },

  // ---------------------------------------------------------------------------
  // Search Bar
  // ---------------------------------------------------------------------------
  {
    "context": "BufferSearchBar",
    "unbind": {
      "ctrl-h": "search::ToggleReplace"
    },
    "bindings": {
      "ctrl-alt-h": "search::ToggleReplace"
    }
  }
]
