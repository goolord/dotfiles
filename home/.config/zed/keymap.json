// Zed keymap
//
// For information on binding keys, see the Zed
// documentation: https://zed.dev/docs/key-bindings
//
// To see the default key bindings run `zed: open default keymap`
// from the command palette.
[
  // ---------------------------------------------------------------------------
  // Window navigation (ctrl-hjkl, mirrors nvim's `wincmd`)
  // ---------------------------------------------------------------------------
  // Workspace covers panels/docks; VimControl is needed too because the
  // editor's own bindings (e.g. vim's ctrl-j -> vim::Down, ctrl-h -> replace)
  // take precedence over Workspace ones.
  {
    "context": "Workspace || VimControl && !menu",
    "bindings": {
      "ctrl-h": "workspace::ActivatePaneLeft",
      "ctrl-j": "workspace::ActivatePaneDown",
      "ctrl-k": "workspace::ActivatePaneUp",
      "ctrl-l": "workspace::ActivatePaneRight"
    }
  },

  // ---------------------------------------------------------------------------
  // Leader (space) bindings
  // ---------------------------------------------------------------------------
  // Default vim keymap binds `space f` on non-editor screens, which would
  // shadow the `space f _` group below.
  {
    "context": "EmptyPane || SharedScreen || ProjectDiff || ProjectSearchView",
    "unbind": {
      "space f": "file_finder::Toggle"
    }
  },
  {
    "context": "Editor && mode == full && vim_mode == normal && vim_operator == none && !BufferSearchBar || EmptyPane || SharedScreen || ProjectDiff || ProjectSearchView",
    "bindings": {
      "space d": "project_panel::ToggleFocus",
      "space t": "terminal_panel::Toggle",

      // Find
      "space f f": "file_finder::Toggle",
      "space f g": "workspace::NewSearch",
      "space f b": "tab_switcher::Toggle",
      "space f s": "project_symbols::Toggle",
      "space f d": "diagnostics::Deploy",
      "space f m": "zed::OpenKeymap",
      "space f :": "command_palette::Toggle",

      // Trouble
      "space r r": "diagnostics::Deploy",

      // Session
      "space s l": "projects::OpenRecent"
    }
  },

  // ---------------------------------------------------------------------------
  // Editor (vim normal mode)
  // ---------------------------------------------------------------------------
  {
    "context": "Editor && vim_mode == normal && vim_operator == none && !menu",
    "bindings": {
      "alt-m": ["workspace::SendKeystrokes", "@ q"],
      "space x": ["workspace::SendKeystrokes", ": % s / / / g enter"]
    }
  },

  // ---------------------------------------------------------------------------
  // Terminal Panel
  // ---------------------------------------------------------------------------
  {
    "context": "Terminal",
    "bindings": {
      "escape": "terminal_panel::Toggle"
    }
  },

  // ---------------------------------------------------------------------------
  // Project Panel
  // ---------------------------------------------------------------------------
  {
    "context": "ProjectPanel && not_editing && !BufferSearchBar",
    "bindings": {
      "space d": "workspace::ToggleLeftDock",
      "l": "project_panel::Open",
      "q": "project_panel::Toggle"
    }
  },

  // ---------------------------------------------------------------------------
  // Search Bar
  // ---------------------------------------------------------------------------
  // Frees ctrl-h for pane navigation.
  {
    "context": "BufferSearchBar",
    "unbind": {
      "ctrl-h": "search::ToggleReplace"
    },
    "bindings": {
      "ctrl-alt-h": "search::ToggleReplace"
    }
  }
]
