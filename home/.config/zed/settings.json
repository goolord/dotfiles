// Zed settings
//
// For information on how to configure Zed, see the Zed
// documentation: https://zed.dev/docs/configuring-zed
//
// To see all of Zed's default settings without changing your
// custom settings, run the `open default settings` command
// from the command palette or from `Zed` application menu.
{
  "context_servers": {
    "mcp-server-exa-search": {
      "enabled": false, // Disable by default; search schemas add tokens to every request
      "remote": false,
      "settings": {
        "exa_api_key": "YOUR_KEY_HERE"
      }
    }
  },
  "tab_size": 2,
  "auto_indent_on_paste": false,
  "auto_indent": "preserve_indent",
  "restore_on_startup": "launchpad",
  "language_models": {
    "ollama": {
      "context_window": 32768
    }
  },
  "git": {
    "inline_blame": {
      "enabled": false
    }
  },
  "cli_default_open_behavior": "existing_window",
  "buffer_font_weight": 450.0,
  "terminal": {
    "shell": "system",
    "minimum_contrast": 45.0,
    "dock": "right"
  },
  "vim": {
    "use_system_clipboard": "never"
  },
  "project_panel": {
    "hide_gitignore": false,
    "dock": "left"
  },
  "outline_panel": {
    "dock": "left"
  },
  "collaboration_panel": {
    "dock": "left"
  },
  "git_panel": {
    "dock": "left"
  },
  "indent_guides": {
    "line_width": 0
  },
  "use_smartcase_search": true,
  "agent_servers": {
    "cursor": {
      "default_config_options": {
        "model": "grok-4.6"
      },
      "type": "registry"
    },
    "antigravity-acp": {
      "default_config_options": {
        "model": "gemini-3.7-flash-high",
        "mode": "yolo"
      },
      "type": "registry"
    },
    "github-copilot": {
      "type": "registry"
    }
  },
  "edit_predictions": {
    "provider": "copilot"
  },
  "buffer_line_height": "standard",
  "session": {
    "trust_all_worktrees": true
  },
  "agent": {
    "favorite_models": [
      {
        "provider": "deepseek",
        "model": "deepseek-v4-flash",
        "enable_thinking": false
      },
      {
        "provider": "deepseek",
        "model": "deepseek-v4-flash",
        "enable_thinking": true,
        "effort": "low"
      },
      {
        "provider": "deepseek",
        "model": "deepseek-v4-pro",
        "enable_thinking": true,
        "effort": "low"
      }
    ],
    "default_model": {
      "provider": "deepseek",
      "model": "deepseek-v4-flash",
      "enable_thinking": false
    },
    "auto_compact": {
      "enabled": true,
      "threshold": 0.4
    },
    "terminal_init_command": "",
    "sandbox_permissions": {
      "allow_unsandboxed": true,
      "warn_ntfs_grants": false,
      "allow_all_hosts": true,
      "allow_fs_write_all": true
    },
    "tool_permissions": {
      "default": "allow", // Auto-approves file edits, diffs, diagnostics, and reads
      "tools": {
        "terminal": {
          "default": "confirm", // Halts unexpected/destructive commands
          "always_allow": [
            // Safe inspection commands
            { "pattern": "^(ls|pwd|head|tail|grep|find|cat|which)(\\s|$)" },
            // Build & compile loops
            { "pattern": "^cabal\\s+(build|test|check|run)(\\s|$)" },
            { "pattern": "^ghc\\b" },
            { "pattern": "^ghcup\\s+list(\\s|$)" },
            { "pattern": "^cargo\\s+(check|build|test|clippy)(\\s|$)" },
            { "pattern": "^zig\\s+(build|test)(\\s|$)" },
            // Git read actions
            { "pattern": "^git\\s+(status|diff|log|branch)(\\s|$)" }
          ],
          "always_confirm": [
            // Require explicit confirmation for potentially destructive operations
            { "pattern": "^rm\\b" },
            { "pattern": "^git\\s+(reset|clean|push|checkout)(\\s|$)" }
          ]
        }
      }
    },
    "default_profile": "autonomous-dev",
    "profiles": {
      "autonomous-dev": {
        "default_model": {
          "provider": "deepseek",
          "model": "deepseek-v4-flash",
          "enable_thinking": false
        },
        "name": "Autonomous Dev",
        "tools": {
          "read_file": true,
          "edit_file": true,
          "write_file": true,
          "diagnostics": true,
          "terminal": true,
          "list_directory": true,
          "grep": true,
          "find_path": true,
          "spawn_agent": false, // Keeps loops focused on a single context thread
          "skill": false,
          "fetch": false,
          "copy_path": false,
          "move_path": false,
          "delete_path": false,
          "create_directory": true
        },
        "enable_all_context_servers": false,
        "context_servers": {}
      }
    },
    "dock": "right"
  },
  "cursor_blink": false,
  "theme": "Tomorrow Night Min",
  "theme_overrides": {
    "Tomorrow Night Min": {
      "syntax": {
        "type": {
          "color": "#81A2BE",
          "font_weight": 600
        },
        "type.builtin": {
          "color": "#81A2BE",
          "font_weight": 600
        }
      }
    }
  },
  "buffer_font_family": "Iosevka Custom SemiExtended Nerd Font",
  "buffer_font_size": 16.0,
  "vim_mode": true
}
