#!/usr/bin/env bash
set -euo pipefail

thumb_dir="${XDG_CACHE_HOME:-$HOME/.cache}/cliphist/thumbs"
mkdir -p "$thumb_dir"

if ! mapfile -t entries < <(cliphist list 2>/dev/null); then
    exit 0
fi
[[ ${#entries[@]} -gt 0 ]] || exit 0

declare -A label_count
for entry in "${entries[@]}"; do
    content="${entry#*$'\t'}"
    label_count[$content]=$(( ${label_count[$content]:-0} + 1 ))
done

wofi_lines=()
entry_map=()

for i in "${!entries[@]}"; do
    entry="${entries[$i]}"
    id="${entry%%$'\t'*}"
    content="${entry#*$'\t'}"

    if [[ "$content" == '<meta http-equiv='* ]]; then
        continue
    fi

    label="$content"
    if (( label_count[$content] > 1 )); then
        label="$content · #$id"
    fi

    if [[ "$content" =~ ^\[\[\ binary\ data\ .*[[:space:]](png|jpe?g|bmp|webp|gif)[[:space:]] ]]; then
        ext="${BASH_REMATCH[1],,}"
        thumb="$thumb_dir/${id}.${ext}"
        if [[ ! -f "$thumb" ]]; then
            if ! printf '%s\n' "$entry" | cliphist decode | magick - -resize '256x256>' "$thumb" 2>/dev/null; then
                rm -f "$thumb"
                wofi_lines+=("$label")
                entry_map+=("$i")
                continue
            fi
        fi
        wofi_lines+=("img:$thumb")
        entry_map+=("$i")
    else
        wofi_lines+=("$label")
        entry_map+=("$i")
    fi
done

[[ ${#wofi_lines[@]} -gt 0 ]] || exit 0

selected="$(printf '%s\n' "${wofi_lines[@]}" | wofi --dmenu \
    --prompt Clipboard \
    --insensitive \
    --allow-images \
    --define image_size=100 \
    --define dynamic_lines=true \
    || true)"
[[ -n "$selected" ]] || exit 0

for j in "${!wofi_lines[@]}"; do
    if [[ "${wofi_lines[$j]}" == "$selected" ]]; then
        printf '%s\n' "${entries[entry_map[$j]]}" | cliphist decode | wl-copy
        exit 0
    fi
done
