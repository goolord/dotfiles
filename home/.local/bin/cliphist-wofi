#!/usr/bin/env bash
set -euo pipefail

thumb_dir="${XDG_CACHE_HOME:-$HOME/.cache}/cliphist/thumbs"
mkdir -p "$thumb_dir"

mapfile -t entries < <(cliphist list)

for thumb in "$thumb_dir"/*; do
    [[ -e "$thumb" ]] || continue
    id="${thumb##*/}"
    id="${id%.*}"
    if ! printf '%s\n' "${entries[@]}" | rg -q "^${id}\t"; then
        rm -f "$thumb"
    fi
done

wofi_lines=()
for entry in "${entries[@]}"; do
    id="${entry%%$'\t'*}"
    content="${entry#*$'\t'}"

    if [[ "$content" == '<meta http-equiv='* ]]; then
        continue
    fi

    if [[ "$content" =~ ^\[\[\ binary\ data\ .*[[:space:]](png|jpe?g|bmp)[[:space:]] ]]; then
        ext="${BASH_REMATCH[1],,}"
        thumb="$thumb_dir/${id}.${ext}"
        if [[ ! -f "$thumb" ]]; then
            printf '%s\n' "$entry" | cliphist decode | magick - -resize '256x256>' "$thumb"
        fi
        wofi_lines+=("img:$thumb")
    else
        wofi_lines+=("$content")
    fi
done

[[ ${#wofi_lines[@]} -gt 0 ]] || exit 0

selected="$(printf '%s\n' "${wofi_lines[@]}" | wofi --dmenu \
    --prompt Clipboard \
    --insensitive \
    --allow-images \
    --define image_size=100 \
    --define dynamic_lines=true \
    || true)"
[[ -n "$selected" ]] || exit 0

if [[ "$selected" == img:* ]]; then
    thumb_file="${selected#img:}"
    id="${thumb_file##*/}"
    id="${id%.*}"
    printf '%s\t' "$id" | cliphist decode | wl-copy
else
    for entry in "${entries[@]}"; do
        if [[ "${entry#*$'\t'}" == "$selected" ]]; then
            printf '%s\n' "$entry" | cliphist decode | wl-copy
            exit 0
        fi
    done
fi
